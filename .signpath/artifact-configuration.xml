<?xml version="1.0" encoding="utf-8"?>
<!-- Paste this into the SignPath project, under Artifact configurations. It signs the Windows
     installer and the portable executable that the release workflow uploads (see SIGNING.md). -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="Smith-Chart-Windows-*.exe">
      <authenticode-sign/>
    </pe-file>
  </zip-file>
</artifact-configuration>
